s/HANGS Contract Revenue Procedures v1.3.docx","sha256":"876d8f8ffecfd58552befed0ceb61450f30948700346c2fa00342fb96b3475ba","locator":"Clauses WIP-1 to WIP-7; Appendix A, accounts used in WIP entries, row 10"}]}],"sources":[{"source":"01 Contracts/Contract Register - October 2026.xlsx","locator":"Contracts sheet: the five contract jobs on the schedule and each PM's contract for WIP; Change Orders sheet: every change order and whether the owner signed","sha256":"7b182a4c17615e927c32dce89b183c88296ca9e6c71a024b8162b0c394aa44b9","name":"E01 Contracts","originalSheet":"Contracts","kind":"contracts","moneyColumns":[5,7]},{"source":"01 Contracts/Contract Register - October 2026.xlsx","locator":"Contracts sheet: the five contract jobs on the schedule and each PM's contract for WIP; Change Orders sheet: every change order and whether the owner signed","sha256":"7b182a4c17615e927c32dce89b183c88296ca9e6c71a024b8162b0c394aa44b9","name":"E02 Change Orders","originalSheet":"Change Orders","kind":"contracts","moneyColumns":[3]},{"source":"06 General Ledger/Contracts GL - October 2026.xlsx","locator":"Balances sheet: 1250, 2250, 2260, 4100, 4150, 5100 and 5150 before any October WIP entry","sha256":"8a3c6348ebd66673f7d7392780d4ef416c515d01a67aa01123f7e49f25183315","name":"E03 Contracts GL","originalSheet":"Balances","kind":"gl","moneyColumns":[3,4,5]},{"source":"05 Prior WIP/WIP Schedule - September 30, 2026.xlsx","locator":"WIP Sep 30 sheet: the approved September schedule; Balances sheet: the balances it left in 1250, 2250 and 2260","sha256":"35b6be3e9be4420717a0b70f8a95d11eb4fa5f913f75e00b5e88080998b238e6","name":"E04 WIP Sep 30","originalSheet":"WIP Sep 30","kind":"prior","moneyColumns":[2,3,4,5,6,8,9,10]},{"source":"05 Prior WIP/WIP Schedule - September 30, 2026.xlsx","locator":"WIP Sep 30 sheet: the approved September schedule; Balances sheet: the balances it left in 1250, 2250 and 2260","sha256":"35b6be3e9be4420717a0b70f8a95d11eb4fa5f913f75e00b5e88080998b238e6","name":"E05 WIP Sep 30 Balances","originalSheet":"Balances","kind":"prior","moneyColumns":[1]},{"source":"02 Job Cost/Job Cost Ledger - October 2026.xlsx","locator":"Cost to Sep 30, October Detail, Job Totals and Budgets sheets","sha256":"7a526f65d753a69d02145691b81a4a91cf466fea220fba5809a388f32019de86","name":"E06 Cost to Sep 30","originalSheet":"Cost to Sep 30","kind":"jobcost","moneyColumns":[3]},{"source":"02 Job Cost/Job Cost Ledger - October 2026.xlsx","locator":"Cost to Sep 30, October Detail, Job Totals and Budgets sheets","sha256":"7a526f65d753a69d02145691b81a4a91cf466fea220fba5809a388f32019de86","name":"E07 October Job Cost","originalSheet":"October Detail","kind":"jobcost","moneyColumns":[8]},{"source":"02 Job Cost/Job Cost Ledger - October 2026.xlsx","locator":"Cost to Sep 30, October Detail, Job Totals and Budgets sheets","sha256":"7a526f65d753a69d02145691b81a4a91cf466fea220fba5809a388f32019de86","name":"E08 Job Totals","originalSheet":"Job Totals","kind":"jobcost","moneyColumns":[1,2,3]},{"source":"02 Job Cost/Job Cost Ledger - October 2026.xlsx","locator":"Cost to Sep 30, October Detail, Job Totals and Budgets sheets","sha256":"7a526f65d753a69d02145691b81a4a91cf466fea220fba5809a388f32019de86","name":"E09 Budgets","originalSheet":"Budgets","kind":"jobcost","moneyColumns":[3]},{"source":"03 Estimates/Estimates to Complete - October 2026.xlsx","locator":"Estimates sheet: budget and estimate to complete by job and cost code; Revisions sheet: when each PM last revised","sha256":"305adb22a40d9820f62e74e77f51ccbab40f59b46ef05fb292f287cf0709d879","name":"E10 Estimates","originalSheet":"Estimates","kind":"estimates","moneyColumns":[3,4,5]},{"source":"03 Estimates/Estimates to Complete - October 2026.xlsx","locator":"Estimates sheet: budget and estimate to complete by job and cost code; Revisions sheet: when each PM last revised","sha256":"305adb22a40d9820f62e74e77f51ccbab40f59b46ef05fb292f287cf0709d879","name":"E11 Estimate Revisions","originalSheet":"Revisions","kind":"estimates","moneyColumns":[]},{"source":"04 Billings/Billing Register - October 2026.xlsx","locator":"Pay Applications sheet: every application and draw, inception to date","sha256":"d6a6b5ad974353f639bb74558b1e4bb1c4bbe202f5ae47902afee92c84da9360","name":"E12 Pay Applications","originalSheet":"Pay Applications","kind":"billings","moneyColumns":[4,5,6]},{"source":"08 Change Orders/CO-01 Marlowe Ridge Dental.pdf","locator":"Page 1, read line by line from the PDF text","sha256":"1160fbb4b40c191a5340b5b4d173f98f0a8945321c98912208098733ee1c0e6b","name":"E13 Change Order CO-01","originalSheet":null,"kind":"co","moneyColumns":[1]},{"source":"07 Source Documents/SFC-1184 Sumner Framing Co.pdf","locator":"Page 1, read line by line from the PDF text","sha256":"a90945f50c0b44ad1976f36a599f240331b61cf03620006950d48cb87f562d91","name":"E14 SFC-1184 Invoice","originalSheet":null,"kind":"invoice","moneyColumns":[1]},{"source":"08 Change Orders/CO-01 Marlowe Ridge Dental.pdf","locator":"Page 1","sha256":"1160fbb4b40c191a5340b5b4d173f98f0a8945321c98912208098733ee1c0e6b","name":"CO Page 1","originalSheet":null,"kind":"co","moneyColumns":[]},{"source":"07 Source Documents/SFC-1184 Sumner Framing Co.pdf","locator":"Page 1","sha256":"a90945f50c0b44ad1976f36a599f240331b61cf03620006950d48cb87f562d91","name":"INV Page 1","originalSheet":null,"kind":"invoice","moneyColumns":[]},{"source":"09 Procedures/HANGS Contract Revenue Procedures v1.3.docx","locator":"Clauses WIP-1 to WIP-7; Appendix A, accounts used in WIP entries","sha256":"876d8f8ffecfd58552befed0ceb61450f30948700346c2fa00342fb96b3475ba","name":"E15 Procedures","originalSheet":null,"kind":"procedures","moneyColumns":[]}],"openItems":[{"id":"Cost Coded to the Wrong Job · WIP-3","status":"open","amount":"18750.00","explanation":"SC-2622, Sumner Framing Co for $18,750.00, is booked to job S-2601 but the invoice is for job S-2610. Job S-2601 (Bellhaven Branch Library Renovation) has no budget for cost code 06-100 Rough Framing, so the line was traced to its invoice. SFC-1184 reads \"Larch Hollow Site 3 flex building\" and \"HANGS job S-2610, cost code 06-100\", total $18,750.00, stamped as entered in job cost as SC-2622. AJ-01 moves it to job S-2610 (Flex Industrial Building, Larch Hollow Site 3). Left where it is, job S-2601 looks $18,750.00 further along than it is and job S-2610 looks $18,750.00 more profitable. Total cost in GL 5100 does not change."},{"id":"Loss Contract, Full Provision · WIP-5","status":"open","amount":"5791.42","explanation":"Job S-2610 is now a loss contract: estimated total cost $1,103,150.00 against contract value $1,085,000.00. Flex Industrial Building, Larch Hollow Site 3's estimate rose from $970,000.00 to $1,103,150.00 (rock excavation and a retaining wall at the access drive cut, not in the bid). Estimated gross profit fades $133,150.00, from $115,000.00 to a loss of $18,150.00. Under WIP-5 the whole loss is recognized now. At 68.09% complete, earned revenue is $738,791.42 against $751,150.00 of cost, a loss of $12,358.58 in recognized gross profit; AJ-02 accrues the other $5,791.42 to 2260 so the job carries the full $18,150.00. Before AJ-01 moved $18,750.00 of framing onto this job, it showed $600.00 of profit and no loss at all."},{"id":"Unsigned Change Order in Contract Value · WIP-2","status":"open","amount":"4200.00","explanation":"Job S-2604's contract for WIP includes CO-01 for $4,200.00, which the owner has not signed. The contract register carries $390,700.00 for Marlowe Ridge Dental Tenant Improvement: the original $386,500.00 and CO-01 for $4,200.00. CO-01, submitted October 20, shows \"Owner approval: NOT SIGNED\" and \"Pending owner signature\". Under WIP-2 contract value is $386,500.00; the work's cost stays in the estimate. Including it would have recognized more revenue on this job than the signed contract supports. The schedule uses $386,500.00; ask the owner to sign CO-01 and it enters contract value that month."},{"id":"Estimate to Complete Not Updated · WIP-4","status":"open","amount":"21350.00","explanation":"Job S-2607's estimate to complete was last revised September 22 and is unchanged, line for line, from September 30. Ridgecrest Veterinary Exam Room Expansion took $21,350.00 of cost in October, but every cost code's estimate to complete at October 31 equals its September 30 figure; the revision is dated September 22 with the note \"Rolled forward\". Carried as is, estimated total cost rises by exactly October's cost, from $190,000.00 to $211,350.00, and estimated gross profit fades $21,350.00. That is the mark of an estimate not revised, not a measured fade. Under WIP-4 the schedule recognizes no October revenue on this job until Sam Whitaker revises it: earned revenue stays at September's $133,402.11. On the carried estimate it would be $141,624.70, another $8,222.59."}],"incomplete":true,"research":null}