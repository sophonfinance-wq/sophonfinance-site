"5dde4c9197a72455f29a9ab121014353df2672ea837b382908da6ab142913431","locator":"Adjusted Trial Balance!G12"},{"sheet":"E11 Reporting Procedures","cell":"D12","value":"Compute each financial covenant from the statements, on the lender's definitions. Report the headroom of each; when headroom is less than 10% of the covenant level, warn the Controller before anything goes to the lender.","formula":null,"unit":"text","source":"07 Procedures/HANGS Reporting Procedures v1.3.docx","sha256":"6ca5149801a1ea92cfb37a39671713f743c6863bf8dc984b2f800ab0982e11d2","locator":"Clauses REPORT-1 to REPORT-7; Appendix A, the statement mapping, row 12"}]}],"sources":[{"source":"01 Trial Balance/Adjusted Trial Balance - October 2026.xlsx","locator":"Adjusted Trial Balance sheet: every account at October 31 after the close's proposed entries; Close Entries sheet: RJ-01 to AJ-04 by line","sha256":"5dde4c9197a72455f29a9ab121014353df2672ea837b382908da6ab142913431","name":"E01 Adjusted TB","originalSheet":"Adjusted Trial Balance","kind":"tb","moneyColumns":[3,4,5,6,7,8]},{"source":"01 Trial Balance/Adjusted Trial Balance - October 2026.xlsx","locator":"Adjusted Trial Balance sheet: every account at October 31 after the close's proposed entries; Close Entries sheet: RJ-01 to AJ-04 by line","sha256":"5dde4c9197a72455f29a9ab121014353df2672ea837b382908da6ab142913431","name":"E02 Close Entries","originalSheet":"Close Entries","kind":"tb","moneyColumns":[3,4]},{"source":"01 Trial Balance/Closed Trial Balance - September 2026.xlsx","locator":"Trial Balance sheet: every account at September 30 as closed and approved","sha256":"696910ebe422d02676e94118ccf0836fdc5c79793428777c4ea63e241119d05a","name":"E03 September TB","originalSheet":"Trial Balance","kind":"prior","moneyColumns":[3,4,5]},{"source":"02 Budget/FY2027 Operating Budget.xlsx","locator":"Income Statement Budget sheet: FY2027 by month; Job Budgets sheet: approved job budget lines","sha256":"d5670f071581cd9e56a74b7e31d77be01050eb2dae0d4ea29b6b8