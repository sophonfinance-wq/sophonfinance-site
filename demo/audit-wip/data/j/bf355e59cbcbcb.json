alue":610000,"formula":"='E03 Change Order Log'!D14","unit":"USD"},{"sheet":"E03 Change Order Log","cell":"D14","value":610000,"formula":null,"unit":"USD","source":"02 Jobs/FY2026 change order log.xlsx","sha256":"1a70006b65bde5e71889c53647dddb62aebf3e32cb6da2a1740f091a360f5a92","locator":"Change Orders!D14"},{"sheet":"Change Orders","cell":"C14","value":240000,"formula":"='E04 CO Approvals'!C15","unit":"USD"},{"sheet":"E04 CO Approvals","cell":"C15","value":240000,"formula":null,"unit":"USD","source":"02 Jobs/Signed change order approvals.pdf","sha256":"526d955dbb3fdbbe6f228d8e08bd037ffe6892a647cba7ce35434cca5ddaff27","locator":"PDF pages 1 to 3; the owners’ countersigned change orders, amount approved and date signed"},{"sheet":"E02 Job Schedule","cell":"I8","value":12332320,"formula":null,"unit":"USD","source":"02 Jobs/June 30 2026 contract schedule.xlsx","sha256":"7c980337abc93abaab604368a8b47dc71b169638e36297c5763e9b1abf19f642","locator":"Jun 30 2026!I8"},{"sheet":"E02 Job Schedule","cell":"G8","value":44044000,"formula":null,"unit":"USD","source":"02 Jobs/June 30 2026 contract schedule.xlsx","sha256":"7c980337abc93abaab604368a8b47dc71b169638e36297c5763e9b1abf19f642","locator":"Jun 30 2026!G8"}]}],"sources":[{"source":"01 Client Accounting/FY2026 trial balance.xlsx","locator":"Trial Balance!A8:D50; balance sheet accounts at June 30, 2026 and the year’s income accounts","sha256":"026ae1df3bc807b4d8b8a28184abcb6a0f7ba3df288097cac7949db96868f322","name":"E01 Trial Balance","originalSheet":"Trial Balance","kind":"tb","primary":true},{"source":"02 Jobs/June 30 2026 contract schedule.xlsx","locator":"Jun 30 2026!A8:O14, Completed FY2026!A8:M14 and Jun 30 2025!A8:O13; contract, estimate, cost, earned and billed by job","sha256":"7c980337abc93abaab604368a8b47dc71b169638e36297c5763e9b1abf19f642","name":"E02 Job Schedule","originalSheet":"Jun 30 2026","kind":"wip","primary":true},{"source":"02 Jobs/June 30 2026 contract schedule.xlsx","locator":"Jun 30 2026!A8:O14, Completed FY2026!A8:M14 and Jun 30 2025!A8:O13; contract, estimate, cost, earned and billed by job","sha256":"7c980337abc93abaab604368a8b47dc71b169638e36297c5763e9b1abf19f642","name":"E02 Completed Fy2026","originalSheet":"Completed FY2026","kind":"wip","primary":false},{"source":"02 Jobs/June 30 2026 contract schedule.xlsx","locator":"Jun 30 2026!A8:O14, Completed FY2026!A8:M14 and Jun 30 2025!A8:O13; contract, estimate, cost, earned and billed by job","sha256":"7c980337abc93abaab604368a8b47dc71b169638e36297c5763e9b1abf19f642","name":"E02 Jun 30 2025","originalSheet":"Jun 30 2025","kind":"wip","primary":false},{"source":"02 Jobs/FY2026 change order log.xlsx","locator":"Change Orders!A8:G18 and Contracts!A8:E14; every change order in the June 30 contracts","sha256":"1a70006b65bde5e71889c53647dddb62aebf3e32cb6da2a1740f091a360f5a92","name":"E03 Change Order Log","originalSheet":"Change Orders","kind":"colog","primary":true},{"source":"02 Jobs/FY2026 change order log.xlsx","locator":"Change Orders!A8:G18 and Contracts!A8:E14; every change order in the June 30 contracts","sha256":"1a70006b65bde5e71889c53647dddb62aebf3e32cb6da2a1740f091a360f5a92","name":"E03 Contracts","originalSheet":"Contracts","kind":"colog","primary":false},{"source":"02 Jobs/Signed change order approvals.pdf","locator":"PDF pages 1 to 3; the owners’ countersigned change orders, amount approved and date signed","sha256":"526d955dbb3fdbbe6f228d8e08bd037ffe6892a647cba7ce35434cca5ddaff27","name":"E04 CO Approvals","originalSheet":null,"kind":"approvals","primary":true},{"source":"03 After Year End/September 30 2026 contract schedule.xlsx","locator":"Sep 30 2026!A8:O15 and Jun 30 2026!A8:O14; the quarterly review’s September 30, 2026 schedule","sha256":"c5892a84ebbe541dd816071dd76dae53c0e92e75325d42eb50f18d615fcee364","name":"E05 Sep 30 Schedule","originalSheet":"Sep 30 2026","kind":"later","primary":true},{"source":"03 After Year End/September 30 2026 contract schedule.xlsx","locator":"Sep 30 2026!A8:O15 and Jun 30 2026!A8:O14; the quarterly review’s September 30, 2026 schedule","sha256":"c5892a84ebbe541dd816071dd76dae53c0e92e75325d42eb50f18d615fcee364","name":"E05 Jun 30 2026","originalSheet":"Jun 30 2026","kind":"later","primary":false},{"source":"03 After Year End/Tideflats estimate revision memo.pdf","locator":"PDF page 1; the project manager’s Tideflats estimate revision of September 30, 2026","sha256":"879c2e8233b12ce13aef4ce0f3331f47fa9bad455ce7e379dc870fc05994ab14","name":"E06 Tideflats Memo","originalSheet":null,"kind":"memo","primary":true}],"openItems":[{"id":"WIP-01","status":"open","amount":"103600.00","explanation":"Pier 9 Tech Center’s June 30 contract includes change order CO-07 at $610,000.00, the price HGC asked for the seismic hold-down upgrade. The owner signed it on July 15, 2026 for $240,000.00. The $370,000.00 difference, at 28.0% complete, put $103,600.00 into FY2026 revenue and gross profit, and understates billings in excess of costs and estimated earnings by the same amount. Proposed: debit contract revenue $103,600.00, credit 2300 $103,600.00. 30.5% of materiality, under performance materiality: passed if the client declines. The machine never posts."},{"id":"WIP-02","status":"open","amount":"1196000.00","explanation":"Tideflats Cold Storage’s estimate rose from $16,284,000.00 to $17,480,000.00 after the year end: the supplier’s price notice of August 3, 2026 and cracked panels found on August 11, 2026. Both arose after June 30, so the June estimate stands and the fade is fiscal 2027’s, as the quarterly review recorded. The job still expects $920,000.00 of profit. The CPA decides whether the year-end statements disclose it as a subsequent event, and whether the backcharge claim against the precaster is mentioned. Nothing is adjusted."},{"id":"FADE-01","status":"open","amount":"406560.00","explanation":"Pier 9 Tech Center’s margin fell from 12.0% at June 30, 2025 to 9.0% at June 30, 2026; FY2026 bears $406,560.00 of catch-up. The schedule gives no reason. The September 30 estimate keeps the margin and the costs since have run within it, which supports the June estimate. The CPA reads the project manager’s reforecast and asks what caused the fade."},{"id":"LOSS-01","status":"open","amount":"172600.00","explanation":"Corliss Medical Group’s clinic finished at a loss of $172,600.00 against a bid margin of 10.5%. The loss is fully in FY2026 cost, so nothing more is provided. Its $186,935.00 final billing is disputed and unpaid; the receivables testing decides whether it is collectible."},{"id":"RP-01","status":"open","amount":"292500.00","explanation":"The Juniper Ridge Partners job (J-2625), nine flex units, is built for Juniper Ridge Partners LLC, a commercial developer under the same owners, on land it owns. It earned $292,500.00 in FY2026 at a 10.0% margin. The CPA decides the related party disclosure; the bonding company and the lender read these statements."},{"id":"MAT-01","status":"open","amount":"340000.00","explanation":"Materiality is proposed at $340,000.00, 0.5% of the year’s revenue, with performance materiality $255,000.00 and clearly trivial $17,000.00. The engagement partner sets the final amounts."},{"id":"REP-01","status":"open","amount":null,"explanation":"No management representation letter has been obtained. It should cover the estimates, the change orders counted and the events after the year end."},{"id":"SIGN-01","status":"open","amount":null,"explanation":"These are draft workpapers and a draft findings memo for the engagement partner. They are not an audit report and give no opinion. Nothing has been signed, posted or sent."}],"incomplete":true,"research":null,"filing":"wip-hgc","returnFile":"WIP Findings DRAFT.pdf","returnLabel":"Draft Findings Memo for the CPA","periodLabel":"June 30, 2026"}