","employee":"E-1025","name":"Renata Salazar","title":"Payroll and HR Manager","effective":"2025-12-22","old":"88000.00","new":"98000.00","enteredBy":"Renata Salazar","enteredOn":"2025-12-15","approvedBy":null,"approvedOn":null},{"row":10,"paf":"PAF-25-120","employee":"E-1013","name":"Gabriel Iverson","title":"Estimator","effective":"2025-12-22","old":"122000.00","new":"128000.00","enteredBy":"Renata Salazar","enteredOn":"2025-12-12","approvedBy":"Jordan Hale","approvedOn":"2025-12-11"},{"row":11,"paf":"PAF-25-121","employee":"E-1031","name":"Olivia Kowalczyk","title":"Foreman","effective":"2025-12-22","old":"69.00","new":"72.00","enteredBy":"Renata Salazar","enteredOn":"2025-12-12","approvedBy":"Jordan Hale","approvedOn":"2025-12-11"},{"row":12,"paf":"PAF-25-122","employee":"E-1065","name":"Hana Zamora","title":"Laborer","effective":"2025-12-22","old":"44.00","new":"46.00","enteredBy":"Renata Salazar","enteredOn":"2025-12-12","approvedBy":"Jordan Hale","approvedOn":"2025-12-11"}],"terms":[{"row":8,"employee":"E-1101","name":"Corbin Ashgrove","title":"Laborer","lastDay":"2025-10-10","reason":"Resigned","finalCheck":"2025-10-17","inactivated":"2025-10-17","processedBy":"Renata Salazar"},{"row":9,"employee":"E-1102","name":"Renzo Valloton","title":"Assistant Superintendent","lastDay":"2025-12-05","reason":"Resigned","finalCheck":"2025-12-12","inactivated":"2025-12-12","processedBy":"Renata Salazar"},{"row":10,"employee":"E-1097","name":"Zoe Xiong","title":"Laborer","lastDay":"2026-02-13","reason":"Laid off, end of job","finalCheck":"2026-02-20","inactivated":"2026-02-20","processedBy":"Renata Salazar"},{"row":11,"employee":"E-1098","name":"Bryce Esposito","title":"Journeyman Carpenter","lastDay":"2026-03-27","reason":"Resigned","finalCheck":"2026-04-03","inactivated":"2026-04-03","processedBy":"Renata Salazar"},{"row":12,"employee":"E-1099","name":"Leilani Lachance","title":"Apprentice Carpenter","lastDay":"2026-05-08","reason":"Retired","finalCheck":"2026-05-15","inactivated":"2026-05-15","processedBy":"Renata Salazar"},{"row":13,"employee":"E-1100","name":"Ezra Tamayo","title":"Estimator","lastDay":"2026-05-29","reason":"Resigned","finalCheck":"2026-06-12","inactivated":"2026-06-12","processedBy":"Renata Salazar"}],"inquiry":{"answeredBy":"Dana Whitfield","role":"Controller","answeredOn":"2026-09-18","answers":[{"id":"Q1","topic":"Headcount and wages","question":"How many people did HGC employ, and why did wages rise from FY2025?","answer":"We averaged 91 people per regular payday in FY2025 and about 96 in FY2026: Alder Point and Tideflats added crews. There was no general raise; five people had individual rate changes effective December 22, 2025."},{"id":"Q2","topic":"The June 26 bonus run","question":"What was the June 26, 2026 bonus payroll?","answer":"Project-completion bonuses of $55,500.00 for 6 superintendents and project managers on Harbor Ridge Commons and the Northgate library, approved by the President and CEO on June 19, 2026."},{"id":"Q3","topic":"Shared deposit account","question":"Two employees are paid into the same bank account. Who are they and why?","answer":"Xavier Baptiste (E-1044) and Alicia Baptiste (E-1051), both journeyman carpenters, are married and asked to be paid into their joint account. Both direct deposit forms are signed and in their personnel files with their I-9s and W-4s, and they work on different jobs under different superintendents."},{"id":"Q4","topic":"Rate approvals","question":"Who approves a pay rate change, and were all the FY2026 changes approved?","answer":"The Chief Financial Officer approves field and estimating rates and the President and CEO approves office salaries, on a signed personnel action form before payroll enters the change. Renata Salazar enters every change. Her own increase to $98,000.00 was agreed in her review with the President and CEO, but the form was not signed before she entered it."},{"id":"Q5","topic":"Leavers","question":"How is someone who leaves removed from payroll?","answer":"The superintendent or manager sends the last day worked; payroll pays the final check on the next regular payday and inactivates the employee the same day. Six people left in FY2026."},{"id":"Q6","topic":"Accrued wages","question":"What is accrued for wages at June 30?","answer":"Wages earned from June 22 to 30 and paid on July 10: seven of the nine working days for hourly crews and seven of ten for salaried staff. Employer payroll taxes are expensed when the payroll is paid, so none is accrued."},{"id":"Q7","topic":"L&I deduction","question":"How does the payroll system work out the L&I employee share?","answer":"On the hours payroll sends to the rate: regular hours plus time and a half for overtime, the same premium hours we use for job costing."},{"id":"Q8","topic":"Forms 941","question":"Were all four Forms 941 filed on time, and was any amended?","answer":"Yes. The payroll system files them and I sign them; none was amended. The payroll system makes the deposits on the semiweekly schedule."}]},"folder":[{"docId":"aud-tb","name":"FY2026 trial balance.xlsx","folder":"01 Client Accounting","title":"FY2026 Trial Balance","size":8297},{"docId":"aud-ledger","name":"FY2026 payroll expense ledger.xlsx","folder":"01 Client Accounting","title":"Payroll Expense Ledger","size":9562},{"docId":"aud-register","name":"FY2026 payroll register.xlsx","folder":"02 Payroll Register","title":"Payroll Register and Employee Master","size":107938},{"docId":"aud-hr","name":"FY2026 rate changes and terminations.xlsx","folder":"03 Personnel","title":"Rate Changes and Leavers","size":7066},{"docId":"aud-sample","name":"FY2026 payroll sample support.pdf","folder":"03 Personnel","title":"Support for the Audit Sample","size":20481},{"docId":"aud-f941","name":"FY2026 Form 941 filing summaries.pdf","folder":"04 Tax Filings","title":"Form 941 Filing Summaries","size":8008},{"docId":"aud-inquiry","name":"FY2026 payroll inquiry responses.docx","folder":"05 Inquiry","title":"Controller’s Written Answers","size":38047}],"docs":{"tb":"aud-tb","ledger":"aud-ledger","register":"aud-register","hr":"aud-hr","sample":"aud-sample","f941":"aud-f941","inquiry":"aud-inquiry"},"status":{"year":"FY2026","entity":"HANGS Construction Services LLC","package":{"runId":"20261108-022936-audit-payroll-fy2026","at":"2026-11-08T02:33:27-08:00"},"changesSincePackage":0,"latestChanges":[],"postedJournals":0,"postedAmount":"0.00","unreadMail":5,"invoicesWaiting":14,"openItems":15,"itemsWaitingOnReviewer":0}}